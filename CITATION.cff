    given-names: Antonio
    affiliation: "William & Mary"
    orcid: "https://orcid.org/0000-0002-7965-7712"
repository-code: "https://github.com/aura-lab-wm/harnesslab-workshop"
url: "https://traceharness.dev"
keywords:
  - large language models
  - coding agents
  - software engineering agents
  - benchmarking
  - evaluation
  - agent trajectories
  - observability
references:
