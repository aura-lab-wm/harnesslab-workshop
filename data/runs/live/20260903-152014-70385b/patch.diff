@@ -1,4 +1,45 @@
 def split_row(line: str):
     """Split one CSV line into fields. Fields may be double-quoted; inside a
-    quoted field a comma is literal and a doubled quote is a literal quote."""
-    return [f.strip('"') for f in line.split(",")]
+    quoted field a comma is literal and a doubled quote is a literal quote.
+
+    This is a small CSV parser that does not use the csv module. It handles
+    fields optionally wrapped in double quotes. Inside a quoted field a comma
+    is treated as data and two consecutive double quotes represent one
+    literal double-quote.
+    """
+    fields = []
+    field_chars = []
+    in_quotes = False
+    i = 0
+    n = len(line)
+    while i < n:
+        c = line[i]
+        if in_quotes:
+            if c == '"':
+                # doubled quote -> literal quote
+                if i + 1 < n and line[i + 1] == '"':
+                    field_chars.append('"')
+                    i += 1
+                else:
+                    # end of quoted field
+                    in_quotes = False
+            else:
+                field_chars.append(c)
+        else:
+            if c == '"':
+                # start of quoted field only if at start of field
+                if not field_chars:
+                    in_quotes = True
+                else:
+                    # stray quote in unquoted field, treat as literal
+                    field_chars.append(c)
+            elif c == ',':
+                fields.append(''.join(field_chars))
+                field_chars = []
+            else:
+                field_chars.append(c)
+        i += 1
+    # append last field
+    fields.append(''.join(field_chars))
+    return fields
+
