--- a/tinycsv/rows.py
+++ b/tinycsv/rows.py
@@ -1,4 +1,37 @@
 def split_row(line: str):
     """Split one CSV line into fields. Fields may be double-quoted; inside a
-    quoted field a comma is literal and a doubled quote is a literal quote."""
-    return [f.strip('"') for f in line.split(",")]
+    quoted field a comma is literal and a doubled quote is a literal quote.
+
+    This implements a minimal CSV parser without using the csv module.
+    Doubled quotes inside a quoted field ("") become a single quote.
+    """
+    fields = []
+    cur = []
+    in_quotes = False
+    i = 0
+    while i < len(line):
+        ch = line[i]
+        if in_quotes:
+            if ch == '"':
+                # If next char is also a quote, it's an escaped quote
+                if i + 1 < len(line) and line[i + 1] == '"':
+                    cur.append('"')
+                    i += 1  # skip the escaped quote
+                else:
+                    # end of quoted field
+                    in_quotes = False
+            else:
+                cur.append(ch)
+        else:
+            if ch == '"':
+                in_quotes = True
+            elif ch == ',':
+                fields.append(''.join(cur))
+                cur = []
+            else:
+                cur.append(ch)
+        i += 1
+    # append last field
+    fields.append(''.join(cur))
+    return fields
+
