--- a/tinycsv/rows.py
+++ b/tinycsv/rows.py
@@ -1,4 +1,38 @@
 def split_row(line: str):
     """Split one CSV line into fields. Fields may be double-quoted; inside a
     quoted field a comma is literal and a doubled quote is a literal quote."""
-    return [f.strip('"') for f in line.split(",")]
+    fields = []
+    field_chars = []
+    in_quotes = False
+    i = 0
+    length = len(line)
+    while i < length:
+        ch = line[i]
+        if in_quotes:
+            if ch == '"':
+                # doubled quote -> literal quote
+                if i + 1 < length and line[i + 1] == '"':
+                    field_chars.append('"')
+                    i += 1
+                else:
+                    # end of quoted field
+                    in_quotes = False
+            else:
+                field_chars.append(ch)
+        else:
+            if ch == '"':
+                # start of quoted field
+                in_quotes = True
+            elif ch == ',':
+                fields.append(''.join(field_chars))
+                field_chars = []
+            elif ch == '\n' or ch == '\r':
+                # ignore bare newlines between fields
+                pass
+            else:
+                field_chars.append(ch)
+        i += 1
+
+    # append last field
+    fields.append(''.join(field_chars))
+    return fields
