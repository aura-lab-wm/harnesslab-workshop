--- a/tinycsv/rows.py
+++ b/tinycsv/rows.py
@@ -1,4 +1,36 @@
 def split_row(line: str):
     """Split one CSV line into fields. Fields may be double-quoted; inside a
     quoted field a comma is literal and a doubled quote is a literal quote."""
-    return [f.strip('"') for f in line.split(",")]
+    fields = []
+    field_chars = []
+    in_quotes = False
+    i = 0
+    n = len(line)
+    while i < n:
+        ch = line[i]
+        if ch == '"':
+            if in_quotes:
+                # If next char is also a quote, it's an escaped quote
+                if i + 1 < n and line[i + 1] == '"':
+                    field_chars.append('"')
+                    i += 1
+                else:
+                    # end of quoted field
+                    in_quotes = False
+            else:
+                # start of quoted field only if at field start
+                if not field_chars:
+                    in_quotes = True
+                else:
+                    # quote in middle of unquoted field — treat literally
+                    field_chars.append('"')
+        elif ch == ',' and not in_quotes:
+            fields.append(''.join(field_chars))
+            field_chars = []
+        else:
+            field_chars.append(ch)
+        i += 1
+    # append last field (may be empty)
+    fields.append(''.join(field_chars))
+    return fields
+
