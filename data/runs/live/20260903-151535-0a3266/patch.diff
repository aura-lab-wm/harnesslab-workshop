--- a/cfg/loader.py
+++ b/cfg/loader.py
@@ -1,5 +1,42 @@
 def load_config(defaults: dict, env: dict) -> dict:
     """Return a copy of `defaults` where any env var APP_<KEY> overrides the
-    value for key <key> (lowercased), coerced to the type of the default."""
+    value for key <key> (lowercased), coerced to the type of the default.
+
+    Supported coercions: int, float, bool, str. Unknown types are left as the
+    raw string from env.
+    """
     cfg = dict(defaults)
+    for k, v in env.items():
+        if not k.startswith("APP_"):
+            continue
+        key = k[len("APP_"):].lower()
+        if key not in defaults:
+            continue
+        default_value = defaults[key]
+        target_type = type(default_value)
+        # v is expected to be a string from the environment
+        try:
+            if target_type is bool:
+                val_lower = v.strip().lower()
+                if val_lower in ("1", "true", "yes", "on"):
+                    coerced = True
+                elif val_lower in ("0", "false", "no", "off"):
+                    coerced = False
+                else:
+                    # Fallback: Python truthiness of non-empty string
+                    coerced = bool(v)
+            elif target_type is int:
+                coerced = int(v)
+            elif target_type is float:
+                coerced = float(v)
+            elif target_type is str:
+                coerced = v
+            else:
+                # Unknown type: leave as raw string
+                coerced = v
+        except Exception:
+            # If coercion fails, keep the default value
+            coerced = default_value
+        cfg[key] = coerced
     return cfg
+
