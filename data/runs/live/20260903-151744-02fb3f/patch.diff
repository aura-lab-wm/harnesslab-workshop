--- a/tinycsv/rows.py
+++ b/tinycsv/rows.py
@@ -1,4 +1,32 @@
 def split_row(line: str):
     """Split one CSV line into fields. Fields may be double-quoted; inside a
     quoted field a comma is literal and a doubled quote is a literal quote."""
-    return [f.strip('"') for f in line.split(",")]
+    fields = []
+    cur = []
+    in_quotes = False
+    i = 0
+    length = len(line)
+    while i < length:
+        ch = line[i]
+        if ch == '"':
+            if not in_quotes:
+                # start quoted field
+                in_quotes = True
+            else:
+                # possible end of quoted field or escaped quote
+                # if next char is also a quote, it's an escaped quote
+                if i + 1 < length and line[i + 1] == '"':
+                    cur.append('"')
+                    i += 1  # skip the escaped quote
+                else:
+                    in_quotes = False
+        elif ch == ',' and not in_quotes:
+            fields.append(''.join(cur))
+            cur = []
+        else:
+            cur.append(ch)
+        i += 1
+    # append last field
+    fields.append(''.join(cur))
+    return fields
+
