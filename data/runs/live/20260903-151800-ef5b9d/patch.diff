--- a/cfg/loader.py
+++ b/cfg/loader.py
@@ -2,4 +2,40 @@
     """Return a copy of `defaults` where any env var APP_<KEY> overrides the
     value for key <key> (lowercased), coerced to the type of the default."""
     cfg = dict(defaults)
+    for k, v in env.items():
+        if not k.startswith("APP_"):
+            continue
+        key = k[len("APP_"):].lower()
+        if key not in cfg:
+            continue
+        default_val = cfg[key]
+        # If types already match, assign directly
+        target_type = type(default_val)
+        new_val = v
+        try:
+            if target_type is bool:
+                if isinstance(v, bool):
+                    new_val = v
+                else:
+                    s = str(v).strip().lower()
+                    if s in ("1", "true", "yes", "y", "on"):
+                        new_val = True
+                    elif s in ("0", "false", "no", "n", "off"):
+                        new_val = False
+                    else:
+                        # fallback: non-empty strings -> True
+                        new_val = bool(s)
+            elif target_type is int:
+                new_val = int(v)
+            elif target_type is float:
+                new_val = float(v)
+            elif target_type is str:
+                new_val = str(v)
+            else:
+                # Unknown type: try to cast to the same type via constructor
+                new_val = target_type(v)
+        except Exception:
+            # If coercion fails, leave the default value unchanged
+            continue
+        cfg[key] = new_val
     return cfg
