--- a/tinycsv/rows.py
+++ b/tinycsv/rows.py
@@ -1,4 +1,41 @@
 def split_row(line: str):
     """Split one CSV line into fields. Fields may be double-quoted; inside a
-    quoted field a comma is literal and a doubled quote is a literal quote."""
-    return [f.strip('"') for f in line.split(",")]
+    quoted field a comma is literal and a doubled quote is a literal quote.
+
+    This is a simple parser that does not use the csv module. It handles:
+    - commas inside double-quoted fields
+    - doubled double-quotes ("") inside quoted fields become a single quote
+    - unquoted fields are returned as-is (no trimming)
+    """
+    fields = []
+    cur = []
+    in_quotes = False
+    i = 0
+    length = len(line)
+    while i < length:
+        ch = line[i]
+        if ch == '"':
+            if not in_quotes:
+                # start of quoted field
+                in_quotes = True
+            else:
+                # inside quotes: could be doubled quote for literal quote
+                if i + 1 < length and line[i + 1] == '"':
+                    cur.append('"')
+                    i += 1  # skip the escaped quote
+                else:
+                    # end of quoted field
+                    in_quotes = False
+            # do not append the quote itself
+        elif ch == ',' and not in_quotes:
+            # field separator
+            fields.append(''.join(cur))
+            cur = []
+        else:
+            cur.append(ch)
+        i += 1
+
+    # append last field
+    fields.append(''.join(cur))
+    return fields
+
