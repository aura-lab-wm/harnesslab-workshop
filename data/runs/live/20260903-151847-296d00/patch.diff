@@ -1,4 +1,39 @@
 def split_row(line: str):
     """Split one CSV line into fields. Fields may be double-quoted; inside a
-    quoted field a comma is literal and a doubled quote is a literal quote."""
-    return [f.strip('"') for f in line.split(",")]
+    quoted field a comma is literal and a doubled quote is a literal quote.
+
+    This implements a small CSV parser: it walks the line character by
+    character, tracking whether it's inside a quoted field. Commas outside of
+    quotes split fields. Inside quotes, doubled quotes ("") are interpreted
+    as a single literal quote.
+    """
+    fields = []
+    cur = []
+    in_quotes = False
+    i = 0
+    length = len(line)
+    while i < length:
+        ch = line[i]
+        if ch == '"':
+            if in_quotes:
+                # If next char is also a quote, it's an escaped quote
+                if i + 1 < length and line[i + 1] == '"':
+                    cur.append('"')
+                    i += 1  # skip the escaped quote
+                else:
+                    # closing quote
+                    in_quotes = False
+            else:
+                # opening quote (only if at field start or after comma)
+                in_quotes = True
+        elif ch == ',' and not in_quotes:
+            fields.append(''.join(cur))
+            cur = []
+        else:
+            cur.append(ch)
+        i += 1
+
+    # append last field
+    fields.append(''.join(cur))
+    return fields
+
