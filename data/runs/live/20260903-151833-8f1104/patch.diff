--- a/tinycsv/rows.py
+++ b/tinycsv/rows.py
@@ -1,4 +1,40 @@
 def split_row(line: str):
     """Split one CSV line into fields. Fields may be double-quoted; inside a
     quoted field a comma is literal and a doubled quote is a literal quote."""
-    return [f.strip('"') for f in line.split(",")]
+    fields = []
+    field = []
+    i = 0
+    n = len(line)
+    in_quotes = False
+
+    while i < n:
+        ch = line[i]
+        if ch == '"':
+            if in_quotes:
+                # If next char is also a quote, it's an escaped quote
+                if i + 1 < n and line[i + 1] == '"':
+                    field.append('"')
+                    i += 2
+                    continue
+                # otherwise this closes the quoted section
+                in_quotes = False
+                i += 1
+                continue
+            else:
+                # opening quote
+                in_quotes = True
+                i += 1
+                continue
+        if ch == ',' and not in_quotes:
+            fields.append(''.join(field))
+            field = []
+            i += 1
+            continue
+        # regular character
+        field.append(ch)
+        i += 1
+
+    # append last field
+    fields.append(''.join(field))
+    return fields
+
