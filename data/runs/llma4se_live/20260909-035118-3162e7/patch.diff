--- a/cfg/loader.py
+++ b/cfg/loader.py
@@ -1,5 +1,26 @@
+def _coerce(value, raw):
+    """Coerce the string `raw` to the type of `value`."""
+    if isinstance(value, bool):
+        return str(raw).strip().lower() in ("1", "true", "yes", "on")
+    if isinstance(value, int):
+        return int(raw)
+    if isinstance(value, float):
+        return float(raw)
+    return str(raw)
+
+
 def load_config(defaults: dict, env: dict) -> dict:
     """Return a copy of `defaults` where any env var APP_<KEY> overrides the
     value for key <key> (lowercased), coerced to the type of the default."""
     cfg = dict(defaults)
+    for name, raw in env.items():
+        if not name.startswith("APP_"):
+            continue
+        key = name[len("APP_"):].lower()
+        if key not in cfg:
+            continue
+        try:
+            cfg[key] = _coerce(cfg[key], raw)
+        except (TypeError, ValueError):
+            continue
     return cfg
