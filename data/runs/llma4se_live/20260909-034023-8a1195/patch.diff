--- a/tinycsv/rows.py
+++ b/tinycsv/rows.py
@@ -1,4 +1,33 @@
 def split_row(line: str):
-    """Split one CSV line into fields. Fields may be double-quoted; inside a
-    quoted field a comma is literal and a doubled quote is a literal quote."""
-    return [f.strip('"') for f in line.split(",")]
+    """Split one CSV line into fields.
+
+    Commas inside double-quoted fields are literal, and two consecutive
+    quotes inside a quoted field represent one literal quote.
+    """
+    fields = []
+    field = []
+    in_quotes = False
+    i = 0
+
+    while i < len(line):
+        char = line[i]
+        if in_quotes:
+            if char == '"':
+                if i + 1 < len(line) and line[i + 1] == '"':
+                    field.append('"')
+                    i += 2
+                    continue
+                in_quotes = False
+            else:
+                field.append(char)
+        elif char == '"' and not field:
+            in_quotes = True
+        elif char == ',':
+            fields.append(''.join(field))
+            field = []
+        else:
+            field.append(char)
+        i += 1
+
+    fields.append(''.join(field))
+    return fields
