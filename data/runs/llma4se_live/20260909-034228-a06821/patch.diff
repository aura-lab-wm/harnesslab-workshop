--- a/cfg/loader.py
+++ b/cfg/loader.py
@@ -1,5 +1,26 @@
+def _coerce(val, target_type):
+    if target_type is bool:
+        if isinstance(val, bool):
+            return val
+        s = str(val).strip().lower()
+        if s in ("1", "true", "yes", "on"):
+            return True
+        if s in ("0", "false", "no", "off"):
+            return False
+        return bool(val)
+    return target_type(val)
+
+
 def load_config(defaults: dict, env: dict) -> dict:
     """Return a copy of `defaults` where any env var APP_<KEY> overrides the
-    value for key <key> (lowercased), coerced to the type of the default."""
+    value for key <key> (lowercased), coerced to the type of the default.
+    """
     cfg = dict(defaults)
+    prefix = "APP_"
+    for k, v in env.items():
+        if k.startswith(prefix):
+            target_key = k[len(prefix):].lower()
+            if target_key in cfg:
+                target_type = type(cfg[target_key])
+                cfg[target_key] = _coerce(v, target_type)
     return cfg
