--- a/tinycsv/rows.py
+++ b/tinycsv/rows.py
@@ -1,4 +1,32 @@
 def split_row(line: str):
-    """Split one CSV line into fields. Fields may be double-quoted; inside a
-    quoted field a comma is literal and a doubled quote is a literal quote."""
-    return [f.strip('"') for f in line.split(",")]
+    """Split one CSV line into fields, honoring quoted commas and quotes."""
+    fields = []
+    field = []
+    in_quotes = False
+    at_field_start = True
+    i = 0
+
+    while i < len(line):
+        char = line[i]
+        if char == '"':
+            if in_quotes:
+                if i + 1 < len(line) and line[i + 1] == '"':
+                    field.append('"')
+                    i += 1
+                else:
+                    in_quotes = False
+            elif at_field_start:
+                in_quotes = True
+            else:
+                field.append(char)
+        elif char == ',' and not in_quotes:
+            fields.append(''.join(field))
+            field = []
+            at_field_start = True
+        else:
+            field.append(char)
+            at_field_start = False
+        i += 1
+
+    fields.append(''.join(field))
+    return fields
