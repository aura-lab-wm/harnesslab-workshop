--- a/cfg/loader.py
+++ b/cfg/loader.py
@@ -1,5 +1,24 @@
 def load_config(defaults: dict, env: dict) -> dict:
-    """Return a copy of `defaults` where any env var APP_<KEY> overrides the
-    value for key <key> (lowercased), coerced to the type of the default."""
+    """Return a copy of `defaults` with matching APP_ environment overrides."""
     cfg = dict(defaults)
+
+    for name, value in env.items():
+        if not name.startswith("APP_"):
+            continue
+
+        key = name[4:].lower()
+        if key not in defaults:
+            continue
+
+        default = defaults[key]
+        if isinstance(default, bool):
+            value = str(value).lower() in {"1", "true", "yes", "on"}
+        elif isinstance(default, int):
+            value = int(value)
+        elif isinstance(default, float):
+            value = float(value)
+        else:
+            value = str(value)
+        cfg[key] = value
+
     return cfg
