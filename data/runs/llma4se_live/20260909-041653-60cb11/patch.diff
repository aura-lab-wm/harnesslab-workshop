+    def _cleanup(self):
+        """Remove all files in the cache directory whose entries are expired."""
+        now = self._now()
+        for fname in os.listdir(self.root):
+            if not fname.endswith(".json"):
+                continue
+            p = os.path.join(self.root, fname)
+            try:
+                with open(p) as f:
+                    rec = json.load(f)
+                if now - rec["t"] > self.ttl:
+                    os.remove(p)
+            except (json.JSONDecodeError, OSError):
+                os.remove(p)
