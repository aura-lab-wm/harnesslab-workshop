--- a/tinycsv/rows.py
+++ b/tinycsv/rows.py
@@ -1,4 +1,32 @@
 def split_row(line: str):
     """Split one CSV line into fields. Fields may be double-quoted; inside a
     quoted field a comma is literal and a doubled quote is a literal quote."""
-    return [f.strip('"') for f in line.split(",")]
+    fields = []
+    current = []
+    in_quotes = False
+    i = 0
+    while i < len(line):
+        c = line[i]
+        if c == '"':
+            if in_quotes:
+                # Look ahead for another quote (doubled quote = literal quote)
+                if i + 1 < len(line) and line[i + 1] == '"':
+                    current.append('"')
+                    i += 1  # skip the second quote
+                else:
+                    # End of quoted field
+                    in_quotes = False
+            else:
+                # Start of quoted field
+                in_quotes = True
+        elif c == ',':
+            if in_quotes:
+                current.append(c)
+            else:
+                fields.append(''.join(current))
+                current = []
+        else:
+            current.append(c)
+        i += 1
+    fields.append(''.join(current))
+    return fields
