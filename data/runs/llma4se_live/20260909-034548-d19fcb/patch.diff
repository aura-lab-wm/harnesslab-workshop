--- a/tinycsv/rows.py
+++ b/tinycsv/rows.py
@@ -1,4 +1,28 @@
 def split_row(line: str):
-    """Split one CSV line into fields. Fields may be double-quoted; inside a
-    quoted field a comma is literal and a doubled quote is a literal quote."""
-    return [f.strip('"') for f in line.split(",")]
+    """Split one CSV line into fields.
+
+    Commas inside double-quoted fields are part of the field, and two
+    consecutive quotes inside such a field represent one literal quote.
+    """
+    fields = []
+    field = []
+    quoted = False
+    i = 0
+
+    while i < len(line):
+        char = line[i]
+        if char == '"':
+            if quoted and i + 1 < len(line) and line[i + 1] == '"':
+                field.append('"')
+                i += 2
+                continue
+            quoted = not quoted
+        elif char == ',' and not quoted:
+            fields.append(''.join(field))
+            field = []
+        else:
+            field.append(char)
+        i += 1
+
+    fields.append(''.join(field))
+    return fields
