--- a/cfg/loader.py
+++ b/cfg/loader.py
@@ -1,5 +1,26 @@
+def _coerce(value, default):
+    """Coerce `value` to the type of `default` (bool, int, float, str)."""
+    if isinstance(default, bool):
+        return str(value).strip().lower() in ("1", "true", "yes", "on")
+    if isinstance(default, int):
+        return int(value)
+    if isinstance(default, float):
+        return float(value)
+    return str(value)
+
+
 def load_config(defaults: dict, env: dict) -> dict:
     """Return a copy of `defaults` where any env var APP_<KEY> overrides the
     value for key <key> (lowercased), coerced to the type of the default."""
     cfg = dict(defaults)
+    for key, value in env.items():
+        if not key.startswith("APP_"):
+            continue
+        target = key[len("APP_"):].lower()
+        if target not in cfg:
+            continue
+        try:
+            cfg[target] = _coerce(value, cfg[target])
+        except (TypeError, ValueError):
+            continue
     return cfg
