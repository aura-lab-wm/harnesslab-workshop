--- a/cfg/loader.py
+++ b/cfg/loader.py
@@ -1,5 +1,29 @@
 def load_config(defaults: dict, env: dict) -> dict:
-    """Return a copy of `defaults` where any env var APP_<KEY> overrides the
-    value for key <key> (lowercased), coerced to the type of the default."""
+    """Return a copy of `defaults` with matching APP_ env overrides."""
     cfg = dict(defaults)
+
+    for env_key, raw_value in env.items():
+        if not env_key.startswith("APP_"):
+            continue
+
+        key = env_key[4:].lower()
+        if key not in defaults:
+            continue
+
+        default = defaults[key]
+        if isinstance(default, bool):
+            value = str(raw_value).strip().lower()
+            if value in {"true", "1", "yes", "on"}:
+                cfg[key] = True
+            elif value in {"false", "0", "no", "off"}:
+                cfg[key] = False
+            else:
+                raise ValueError(f"invalid boolean value for {env_key}: {raw_value!r}")
+        elif isinstance(default, int):
+            cfg[key] = int(raw_value)
+        elif isinstance(default, float):
+            cfg[key] = float(raw_value)
+        elif isinstance(default, str):
+            cfg[key] = str(raw_value)
+
     return cfg
