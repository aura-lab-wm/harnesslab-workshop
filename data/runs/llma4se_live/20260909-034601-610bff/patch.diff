--- a/tinycsv/rows.py
+++ b/tinycsv/rows.py
@@ -1,4 +1,39 @@
 def split_row(line: str):
-    """Split one CSV line into fields. Fields may be double-quoted; inside a
-    quoted field a comma is literal and a doubled quote is a literal quote."""
-    return [f.strip('"') for f in line.split(",")]
+    """Split one CSV line into fields.
+
+    A field may be double-quoted.  Commas in quoted fields are data, and a
+    doubled quote inside one represents a literal quote.
+    """
+    fields = []
+    field = []
+    quoted = False
+    field_start = True
+    index = 0
+
+    while index < len(line):
+        char = line[index]
+
+        if quoted:
+            if char == '"':
+                if index + 1 < len(line) and line[index + 1] == '"':
+                    field.append('"')
+                    index += 2
+                    continue
+                quoted = False
+            else:
+                field.append(char)
+        elif field_start and char == '"':
+            quoted = True
+            field_start = False
+        elif char == ',':
+            fields.append(''.join(field))
+            field = []
+            field_start = True
+        else:
+            field.append(char)
+            field_start = False
+
+        index += 1
+
+    fields.append(''.join(field))
+    return fields
