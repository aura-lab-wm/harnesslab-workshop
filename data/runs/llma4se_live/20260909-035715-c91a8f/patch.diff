--- a/cfg/loader.py
+++ b/cfg/loader.py
@@ -1,5 +1,40 @@
 def load_config(defaults: dict, env: dict) -> dict:
-    """Return a copy of `defaults` where any env var APP_<KEY> overrides the
-    value for key <key> (lowercased), coerced to the type of the default."""
+    """Return a copy of ``defaults`` with matching ``APP_`` overrides.
+
+    Environment variable names are matched case-insensitively through their
+    lowercased suffix, and the value is converted using the type of its
+    corresponding default.
+    """
     cfg = dict(defaults)
+    for name, value in env.items():
+        if not name.startswith("APP_"):
+            continue
+
+        key = name[4:].lower()
+        if key not in defaults:
+            continue
+
+        default = defaults[key]
+        if isinstance(default, bool):
+            if isinstance(value, str):
+                normalized = value.strip().lower()
+                if normalized in {"true", "1", "yes", "on"}:
+                    converted = True
+                elif normalized in {"false", "0", "no", "off"}:
+                    converted = False
+                else:
+                    raise ValueError(f"invalid boolean value for {name}: {value!r}")
+            else:
+                converted = bool(value)
+        elif isinstance(default, int):
+            converted = int(value)
+        elif isinstance(default, float):
+            converted = float(value)
+        elif isinstance(default, str):
+            converted = str(value)
+        else:
+            continue
+
+        cfg[key] = converted
+
     return cfg
