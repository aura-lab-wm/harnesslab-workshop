--- a/cfg/loader.py
+++ b/cfg/loader.py
@@ -2,4 +2,22 @@
     """Return a copy of `defaults` where any env var APP_<KEY> overrides the
     value for key <key> (lowercased), coerced to the type of the default."""
     cfg = dict(defaults)
+    for env_key, env_val in env.items():
+        if not env_key.startswith("APP_"):
+            continue
+        key = env_key[4:].lower()
+        if key not in cfg:
+            continue
+        default = cfg[key]
+        cfg[key] = _coerce(env_val, default)
     return cfg
+
+
+def _coerce(value: str, default) -> object:
+    if isinstance(default, bool):
+        return str(value).lower() in ("1", "true", "yes", "on")
+    if isinstance(default, int):
+        return int(value)
+    if isinstance(default, float):
+        return float(value)
+    return value
