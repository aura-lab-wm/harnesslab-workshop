--- a/cfg/loader.py
+++ b/cfg/loader.py
@@ -2,4 +2,22 @@
     """Return a copy of `defaults` where any env var APP_<KEY> overrides the
     value for key <key> (lowercased), coerced to the type of the default."""
     cfg = dict(defaults)
+    for name, value in env.items():
+        if not name.startswith("APP_"):
+            continue
+
+        key = name[4:].lower()
+        if key not in defaults:
+            continue
+
+        default = defaults[key]
+        if isinstance(default, bool):
+            cfg[key] = str(value).strip().lower() in {"1", "true", "yes", "on"}
+        elif isinstance(default, int):
+            cfg[key] = int(value)
+        elif isinstance(default, float):
+            cfg[key] = float(value)
+        elif isinstance(default, str):
+            cfg[key] = str(value)
+
     return cfg
