 def split_row(line: str):
     """Split one CSV line into fields. Fields may be double-quoted; inside a
     quoted field a comma is literal and a doubled quote is a literal quote."""
-    return [f.strip('"') for f in line.split(",")]
+    fields = []
+    field = []
+    in_quotes = False
+    i = 0
+    while i < len(line):
+        ch = line[i]
+        if in_quotes:
+            if ch == '"':
+                # Look ahead for a doubled quote
+                if i + 1 < len(line) and line[i + 1] == '"':
+                    field.append('"')
+                    i += 2
+                    continue
+                else:
+                    in_quotes = False
+                    i += 1
+                    continue
+            else:
+                field.append(ch)
+                i += 1
+        else:
+            if ch == '"':
+                in_quotes = True
+                i += 1
+            elif ch == ',':
+                fields.append(''.join(field))
+                field = []
+                i += 1
+            else:
+                field.append(ch)
+                i += 1
+    # Append the last field
+    fields.append(''.join(field))
+    return fields
