--- a/tinycsv/rows.py
+++ b/tinycsv/rows.py
@@ -1,4 +1,36 @@
 def split_row(line: str):
-    """Split one CSV line into fields. Fields may be double-quoted; inside a
-    quoted field a comma is literal and a doubled quote is a literal quote."""
-    return [f.strip('"') for f in line.split(",")]
+    """Split one CSV line into fields.
+
+    Commas inside double-quoted fields are part of the field, and ``""``
+    inside such a field is an escaped (literal) double quote.
+    """
+    fields = []
+    field = []
+    in_quotes = False
+    i = 0
+
+    while i < len(line):
+        char = line[i]
+
+        if char == '"':
+            if in_quotes:
+                # A pair of quotes in a quoted field represents one quote.
+                if i + 1 < len(line) and line[i + 1] == '"':
+                    field.append('"')
+                    i += 2
+                    continue
+                in_quotes = False
+            else:
+                in_quotes = True
+            i += 1
+            continue
+
+        if char == ',' and not in_quotes:
+            fields.append(''.join(field))
+            field = []
+        else:
+            field.append(char)
+        i += 1
+
+    fields.append(''.join(field))
+    return fields
