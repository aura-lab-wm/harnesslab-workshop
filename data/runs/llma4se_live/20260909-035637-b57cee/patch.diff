--- a/tinycsv/rows.py
+++ b/tinycsv/rows.py
@@ -1,4 +1,41 @@
 def split_row(line: str):
-    """Split one CSV line into fields. Fields may be double-quoted; inside a
-    quoted field a comma is literal and a doubled quote is a literal quote."""
-    return [f.strip('"') for f in line.split(",")]
+    """Split one CSV line into fields.
+
+    Commas inside double-quoted fields are part of the field, and two
+    consecutive double quotes inside such a field represent one quote.
+    """
+    fields = []
+    field = []
+    in_quotes = False
+    at_field_start = True
+    index = 0
+
+    while index < len(line):
+        char = line[index]
+
+        if in_quotes:
+            if char == '"':
+                # A quote followed by another quote is an escaped quote,
+                # rather than the end of the field.
+                if index + 1 < len(line) and line[index + 1] == '"':
+                    field.append('"')
+                    index += 2
+                    continue
+                in_quotes = False
+            else:
+                field.append(char)
+        elif char == ',' :
+            fields.append(''.join(field))
+            field = []
+            at_field_start = True
+        elif char == '"' and at_field_start:
+            in_quotes = True
+            at_field_start = False
+        else:
+            field.append(char)
+            at_field_start = False
+
+        index += 1
+
+    fields.append(''.join(field))
+    return fields
