--- a/cfg/loader.py
+++ b/cfg/loader.py
@@ -1,5 +1,26 @@
+def _coerce(val, target_type):
+    if target_type is bool:
+        if isinstance(val, bool):
+            return val
+        if isinstance(val, str):
+            lowered = val.strip().lower()
+            if lowered in ("1", "true", "yes", "on"):
+                return True
+            if lowered in ("0", "false", "no", "off"):
+                return False
+        return bool(val)
+    return target_type(val)
+
+
 def load_config(defaults: dict, env: dict) -> dict:
     """Return a copy of `defaults` where any env var APP_<KEY> overrides the
     value for key <key> (lowercased), coerced to the type of the default."""
     cfg = dict(defaults)
+    prefix = "APP_"
+    for env_key, env_val in env.items():
+        if env_key.startswith(prefix):
+            cfg_key = env_key[len(prefix):].lower()
+            if cfg_key in cfg:
+                target_type = type(cfg[cfg_key])
+                cfg[cfg_key] = _coerce(env_val, target_type)
     return cfg
