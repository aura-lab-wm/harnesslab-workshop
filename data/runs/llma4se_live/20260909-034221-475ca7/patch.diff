--- a/tinycsv/rows.py
+++ b/tinycsv/rows.py
@@ -1,4 +1,29 @@
 def split_row(line: str):
-    """Split one CSV line into fields. Fields may be double-quoted; inside a
-    quoted field a comma is literal and a doubled quote is a literal quote."""
-    return [f.strip('"') for f in line.split(",")]
+    """Split one CSV line into fields, honoring quoted commas and quotes."""
+    fields = []
+    field = []
+    in_quotes = False
+    index = 0
+
+    while index < len(line):
+        char = line[index]
+        if in_quotes:
+            if char == '"':
+                if index + 1 < len(line) and line[index + 1] == '"':
+                    field.append('"')
+                    index += 2
+                    continue
+                in_quotes = False
+            else:
+                field.append(char)
+        elif char == '"':
+            in_quotes = True
+        elif char == ',':
+            fields.append(''.join(field))
+            field = []
+        else:
+            field.append(char)
+        index += 1
+
+    fields.append(''.join(field))
+    return fields
