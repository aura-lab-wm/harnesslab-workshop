+                            # A more robust solution might raise a ValueError
+                            pass
+                    else:
+                        # Coerce to the type of the default value
+                        cfg[config_key] = type(default_value)(value)
+                except (ValueError, TypeError):
+                    # Handle cases where coercion fails, e.g., non-numeric string for int/float
+                    # For now, we'll ignore the override if coercion fails,
