--- a/cfg/loader.py
+++ b/cfg/loader.py
@@ -2,4 +2,20 @@
     """Return a copy of `defaults` where any env var APP_<KEY> overrides the
     value for key <key> (lowercased), coerced to the type of the default."""
     cfg = dict(defaults)
+    for env_key, env_val in env.items():
+        if env_key.startswith("APP_"):
+            key = env_key[4:].lower()
+            if key in cfg:
+                cfg[key] = _coerce(env_val, type(cfg[key]))
     return cfg
+
+
+def _coerce(val, typ):
+    """Coerce string `val` to `typ` (int, float, bool, str)."""
+    if typ is bool:
+        return val.lower() in ("1", "true", "yes")
+    if typ is int:
+        return int(val)
+    if typ is float:
+        return float(val)
+    return val
