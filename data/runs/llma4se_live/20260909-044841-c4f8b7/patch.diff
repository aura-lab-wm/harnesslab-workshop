@@ -1,4 +1,38 @@
 def split_row(line: str):
     """Split one CSV line into fields. Fields may be double-quoted; inside a
     quoted field a comma is literal and a doubled quote is a literal quote."""
-    return [f.strip('"') for f in line.split(",")]
+    fields = []
+    current = []
+    in_quotes = False
+    i = 0
+    while i < len(line):
+        ch = line[i]
+        if in_quotes:
+            if ch == '"':
+                # Look ahead for another quote (doubled quote -> literal quote)
+                if i + 1 < len(line) and line[i + 1] == '"':
+                    current.append('"')
+                    i += 2
+                    continue
+                else:
+                    # End of quoted field
+                    in_quotes = False
+                    i += 1
+                    continue
+            else:
+                current.append(ch)
+                i += 1
+        else:
+            if ch == '"':
+                in_quotes = True
+                i += 1
+            elif ch == ',':
+                fields.append(''.join(current))
+                current = []
+                i += 1
+            else:
+                current.append(ch)
+                i += 1
+    # Last field
+    fields.append(''.join(current))
+    return fields
