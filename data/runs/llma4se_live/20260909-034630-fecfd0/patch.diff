+    def cleanup(self):
+        for filename in os.listdir(self.root):
+            if filename.endswith(".json"):
+                p = os.path.join(self.root, filename)
+                try:
+                    with open(p) as f:
+                        rec = json.load(f)
+                    if self._now() - rec['t'] > self.ttl:
+                        os.remove(p)
+                except (IOError, json.JSONDecodeError):
