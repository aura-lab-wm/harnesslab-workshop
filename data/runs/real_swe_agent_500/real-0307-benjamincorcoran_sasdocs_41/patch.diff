diff --git a/test_parsy.py b/test_parsy.py
new file mode 100644
index 0000000..ca92caf
--- /dev/null
+++ b/test_parsy.py
@@ -0,0 +1,16 @@
+from sasdocs.objects import datastep, proc
+
+# Data step with options
+datastep_code = """
+data test / view=testvew;
+    set test;
+run;
+"""
+
+# Procedure with options
+proc_code = """
+proc sort data=foo out=bar; by A; run;
+"""
+
+print("Data step options:", datastep.parse_partial(datastep_code))
+print("Procedure options:", proc.parse_partial(proc_code))
