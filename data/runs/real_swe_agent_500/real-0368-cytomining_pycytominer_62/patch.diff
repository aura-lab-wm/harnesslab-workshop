diff --git a/test_drop_extreme_outliers.py b/test_drop_extreme_outliers.py
new file mode 100644
index 0000000..d00cb6b
--- /dev/null
+++ b/test_drop_extreme_outliers.py
@@ -0,0 +1,21 @@
+import pandas as pd
+from pycytominer.feature_select import feature_select
+
+# Generate a sample dataset with extreme outlier features
+data = {
+    "feature1": [1, 2, 3, 4, 5],
+    "feature2": [10, 20, 30, 40, 50],
+    "feature3": [100, 200, 300, 400, 500],
+    "feature4": [1000, 2000, 3000, 4000, 5000],
+    "feature5": [10000, 20000, 30000, 40000, 50000],
+}
+df = pd.DataFrame(data)
+
+# Apply the drop_extreme_outliers operation
+selected_features = feature_select(
+    profiles=df,
+    features=list(df.columns),
+    operation="drop_extreme_outliers",
+)
+
+print("Selected features:", selected_features)
