
diff --git a/install_dependencies.py b/install_dependencies.py
new file mode 100644
index 0000000..281556a
--- /dev/null
+++ b/install_dependencies.py
@@ -0,0 +1,18 @@
+import subprocess
+
+# Install a package using pip
+package_to_install = "numpy"
+
+# Log the output
+with open("pip_log.txt", "w") as log_file:
+    process = subprocess.Popen(["pip", "install", package_to_install], stdout=log_file, stderr=log_file)
+
+# Wait for the process to complete
+process.wait()
+
+# Check the exit code
+exit_code = process.returncode
+if exit_code != 0:
+    print("Error installing package:", exit_code)
+else:
+    print("Package installed successfully")
