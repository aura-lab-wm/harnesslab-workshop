     elif isinstance(obj, FileInclude):
         return _format_include(obj, indent)
+    elif obj == 'LineComment' or obj == 'BlockComment':
+        return str(obj)
     else:
-        raise ValueError(f'cannot format object as TDL: {obj!r}')
+        # Assume obj is a string containing TDL content
+        return _format_content(obj, indent)
+
+def _format_content(content, indent):
+    # Split content into terms and comments
+    terms = []
+    comments = []
+    for line in content.splitlines():
+        if line.startswith('//') or line.startswith('/*'):
+            comments.append(line)
+        else:
+            terms.append(line)
+
+    # Format terms and comments separately
+    formatted_terms = [format(term, indent) for term in terms]
+    formatted_comments = [format(comment, indent) for comment in comments]
+
+    # Combine formatted terms and comments
+    return '\n'.join(formatted_terms + formatted_comments)
 
 
