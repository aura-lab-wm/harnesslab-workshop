+
+tdl_content = """
+TypeDefinition: lex-item &
+  [ SYNSEM.LOCAL.CAT.HEAD.MOD < > ].
+
+// This is a line comment
+TypeAddendum: lex-item &
+  [ SYNSEM.LOCAL.CAT.HEAD.MOD < > ].
+
+/*
+This is a block comment.
+It can span multiple lines.
+*/
+TypeAddendum: lex-item &
+  [ SYNSEM.LOCAL.CAT.HEAD.MOD < > ].
+"""
+
+print(format(tdl_content))
