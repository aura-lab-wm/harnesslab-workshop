diff --git a/test_format.py b/test_format.py
new file mode 100644
index 0000000..685cd64
--- /dev/null
+++ b/test_format.py
@@ -0,0 +1,23 @@
+from delphin.tdl import Term, format
+
+def test_format():
+    # Simulate LineComment and BlockComment as subclasses of Term
+    class LineComment(Term):
+        pass
+
+    class BlockComment(Term):
+        pass
+
+    # Create instances of LineComment and BlockComment
+    line_comment = LineComment()
+    block_comment = BlockComment()
+
+    # Check if the format method works correctly
+    assert format(line_comment) is not None, "LineComment formatting failed"
+    assert format(block_comment) is not None, "BlockComment formatting failed"
+
+    print("All tests passed successfully")
+
+if __name__ == "__main__":
+    test_format()
+    print("Script completed successfully, no errors.")
