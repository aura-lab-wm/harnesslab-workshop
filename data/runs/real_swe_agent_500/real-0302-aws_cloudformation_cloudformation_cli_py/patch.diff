diff --git a/reproduce.sh b/reproduce.sh
new file mode 100755
index 0000000..37de625
--- /dev/null
+++ b/reproduce.sh
@@ -0,0 +1,20 @@
+#!/bin/bash
+
+# Define the expected dependencies
+expected_dependencies="dependency1 dependency2"
+
+# Create a temporary build directory
+build_dir=$(mktemp -d)
+
+# Submit the configuration to the build directory
+cfn package
+
+# Check if the build directory contains the expected dependencies
+if [ -z "$(ls -F $build_dir | grep -E '{}')".format(expected_dependencies) ]; then
+  echo "Dependencies not found in the build directory"
+else
+  echo "Dependencies found in the build directory"
+fi
+
+# Remove the temporary build directory
+rm -r $build_dir
