+class CommentTerm(Term):
+    """
+    Class for handling LineComment and BlockComment events.
+    
+    This subclass of :class:`Term` is responsible for formatting 
+    LineComment and BlockComment events as TDL strings.
+    """
 
+    def __init__(self, docstring=None):
+        super().__init__(docstring=docstring)
+
+    def format(self, indent=0):
+        """
+        Format the comment event as a TDL string.
+        
+        Args:
+            indent (int): number of spaces to indent the formatted object
+        Returns:
+            str: serialized form of the comment event
+        """
+        if self.docstring is not None:
+            return '{}\n{}{}'.format(
+                _format_docstring(self.docstring, indent),
+                ' ' * indent,
+                ';'
+            )
+        else:
+            return ';'
 
