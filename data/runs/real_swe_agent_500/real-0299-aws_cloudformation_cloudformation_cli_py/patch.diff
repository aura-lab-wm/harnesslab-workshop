diff --git a/reproduce_bug.py b/reproduce_bug.py
new file mode 100644
index 0000000..437d015
--- /dev/null
+++ b/reproduce_bug.py
@@ -0,0 +1,33 @@
+import subprocess
+import os
+import shutil
+
+# Define the dummy dependency to be installed
+dependency = "example-package"
+
+# Define the build directory where dependencies are installed
+build_dir = "build"
+
+# Define the plugin versions to test
+plugin_versions = ["2.1.5", "2.1.6"]
+
+for version in plugin_versions:
+    # Create a temporary directory to mimic the plugin environment
+    temp_dir = f"temp_{version}"
+    os.mkdir(temp_dir)
+
+    # Install the plugin version
+    subprocess.run(["pip", "install", f"cloudformation-cli-python-plugin=={version}"], check=True)
+
+    # Submit the code using the installed plugin version
+    subprocess.run(["cfn", "submit", "--dry-run"], check=True)
+
+    # Check the build directory for the installed dependency
+    dependency_installed = dependency in os.listdir(build_dir)
+
+    print(f"Plugin version {version}: Dependency installed: {dependency_installed}")
+
+    # Clean up by removing the temporary directory
+    shutil.rmtree(temp_dir)
+
+print("Script completed successfully, no errors.")
