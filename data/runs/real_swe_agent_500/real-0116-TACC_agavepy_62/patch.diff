new file mode 100644
index 0000000..bb4dafb
--- /dev/null
+++ b/test_save_config.py
@@ -0,0 +1,35 @@
+from agavepy.utils.cachedir_helpers import save_config
+from pathlib import Path
+import json
+
+# Mock cache directory
+cache_dir = Path("mock_cache_dir")
+
+# Mock current context
+current_context = {
+    "tenantid": "sd2e",
+    "username": "admin",
+    "clientname": "client-1",
+    "config": {
+        "access_token": "some-token",
+        "refresh_token": "some-refresh-token",
+        "base_url": "https://example.com"
+    }
+}
+
+# Call the function
+save_config(cache_dir, current_context)
+
+# Check if the config file was created
+config_file = cache_dir / "config.json"
+assert config_file.exists(), "Config file was not created"
+
+# Load the config file
+with open(config_file, "r") as f:
+    agave_context = json.load(f)
+
+# Check if the context was saved correctly
+assert agave_context["current"] == current_context["config"], "Current context was not saved correctly"
+assert agave_context["sessions"][current_context["tenantid"]]["admin"][current_context["clientname"]] == current_context["config"], "Session context was not saved correctly"
+
+print("All tests passed successfully")
