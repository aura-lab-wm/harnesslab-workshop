new file mode 100644
index 0000000..5c124d1
--- /dev/null
+++ b/test_parse_vdj_paths.py
@@ -0,0 +1,15 @@
+from igseq.vdj import parse_vdj_paths
+from pathlib import Path
+
+def test_parse_vdj_paths():
+    paths = [
+        "sonarramesh/IGH",
+        "sonarramesh/IGH/IGHD",
+        "sonarramesh/IGH/IGHD",  # Duplicate
+        "sonarramesh/IGK",
+    ]
+    result = parse_vdj_paths(paths)
+    # Check that there are no duplicates in the paths list
+    assert len(set(paths)) == len(result)
+
+test_parse_vdj_paths()
