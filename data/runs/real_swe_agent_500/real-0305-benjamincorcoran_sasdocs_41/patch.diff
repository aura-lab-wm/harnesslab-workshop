
diff --git a/check_sas_syntax.py b/check_sas_syntax.py
new file mode 100644
index 0000000..a47767b
--- /dev/null
+++ b/check_sas_syntax.py
@@ -0,0 +1,16 @@
+import saslex
+
+# Open the reproduce.sas file
+with open("reproduce.sas", "r") as f:
+    sas_code = f.read()
+
+# Tokenize the SAS code
+tokens = saslex.tokenize(sas_code)
+
+# Check for any invalid tokens
+for token in tokens:
+    if token.type == "INVALID":
+        print(f"Error: Invalid token {token.value} at line {token.line}, column {token.column}")
+        break
+
+print("Script completed successfully, no errors.")
diff --git a/parse_sas_code.py b/parse_sas_code.py
new file mode 100644
index 0000000..2e9448b
--- /dev/null
+++ b/parse_sas_code.py
@@ -0,0 +1,19 @@
+# Open the reproduce.sas file
+with open("reproduce.sas", "r") as f:
+    sas_code = f.read()
+
+# Check for unbalanced parentheses
+open_parentheses = sas_code.count("(")
+close_parentheses = sas_code.count(")")
+if open_parentheses != close_parentheses:
+    print("Error: Unbalanced parentheses")
+    exit(1)
+
+# Check for invalid characters
+invalid_chars = ["'", '"', ";"]
+for char in invalid_chars:
+    if char in sas_code:
+        print(f"Error: Invalid character {char} found")
+        exit(1)
+
+print("Script completed successfully, no errors.")
