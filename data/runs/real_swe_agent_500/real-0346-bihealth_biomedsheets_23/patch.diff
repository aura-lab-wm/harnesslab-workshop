+tsv_data = """
+patientName,fatherName,motherName,sex,isAffected,folderName,hpoTerms,libraryType
+John-Doe,0,0,male,unaffected,folder1,HTN,GENOME
+"""
+
+# Attempt to load the TSV file
+try:
+    f = StringIO(tsv_data)
+    sheet = read_germline_tsv_sheet(f)
+    print("Test passed: TSV sheet loaded successfully with patient name 'John-Doe'")
+except Exception as e:
+    print("Test failed:", e)
