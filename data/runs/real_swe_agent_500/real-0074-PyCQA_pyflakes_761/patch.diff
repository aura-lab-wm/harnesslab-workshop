diff --git a/test_checker.py b/test_checker.py
new file mode 100644
index 0000000..c5ed0de
--- /dev/null
+++ b/test_checker.py
@@ -0,0 +1,16 @@
+from pyflakes.checker import Checker
+from pyflakes.messages import ClassAttributeRedefinition
+
+code = """
+class Test:
+    attr = 0
+    def method(self):
+        self.attr = 1
+"""
+
+checker = Checker(code)
+checker.check()
+
+for msg in checker.messages:
+    if isinstance(msg, ClassAttributeRedefinition):
+        print(f"Attribute redefinition: {msg}")
