diff --git a/convert_config.py b/convert_config.py
new file mode 100644
index 0000000..1a2ce13
--- /dev/null
+++ b/convert_config.py
@@ -0,0 +1,35 @@
+import json
+
+# Read the old configuration file
+with open("config.json", "r") as f:
+    config = json.load(f)
+
+# Reorganize the configuration entries
+new_config = {
+    "current": {
+        "client-1": config["current"]
+    },
+    "sessions": {
+        "sd2e": {
+            "admin": {
+                "client-1": config["sessions"]["sd2e"]["admin"],
+                "client-2": config["sessions"]["sd2e"]["user1"]
+            },
+            "user1": {
+                "client-1": config["sessions"]["sd2e"]["user2"],
+                "client-2": config["sessions"]["sd2e"]["user3"]
+            }
+        },
+        "tacc": {
+            "admin": {
+                "client-1": config["sessions"]["tacc"]["admin"]
+            }
+        }
+    }
+}
+
+# Write the new configuration file
+with open("config.json", "w") as f:
+    json.dump(new_config, f, indent=4)
+
+print("Configuration file converted successfully.")
