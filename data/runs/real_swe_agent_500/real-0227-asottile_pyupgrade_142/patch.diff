index 0000000..7401f2b
--- /dev/null
+++ b/test_fix.py
@@ -0,0 +1,10 @@
+import pyupgrade
+
+def test_fix():
+    string = 'hello\\Nworld'
+    expected = 'hello\\Nworld'
+    result = pyupgrade.fix_escape_sequences(string)
+    assert result == expected, f"Fix failed: {result} != {expected}"
+
+test_fix()
+print("Test passed!")
