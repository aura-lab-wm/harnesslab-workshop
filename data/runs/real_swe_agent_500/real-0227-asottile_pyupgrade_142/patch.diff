+from pyupgrade import _fix_escape_sequences
+from tokenize_rt import Token
+
+def test_fix():
+    token = Token('STRING', 'hello\\Nworld')
+    expected = 'hello\\\\Nworld'
+    result = _fix_escape_sequences(token)
+    assert result.src == expected, f"Fix failed: {result.src} != {expected}"
+
+test_fix()
+print("Test passed!")
