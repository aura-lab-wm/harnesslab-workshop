@@ -0,0 +1,17 @@
+from biomedsheets.io_tsv.germline import GermlineTSVReader
+from io import StringIO
+
+# Create a test TSV file with a patient name that includes a hyphen
+tsv_data = StringIO(
+    "patientName\tfatherName\tmotherName\tsex\tisAffected\tfolderName\thpoTerms\tlibraryType\n"
+    "Smith-Jones\tJoseph\tMary\tM\tY\tfolder1\thpoTerm1\tWES\n"
+    "Smith\tJoseph\tMary\tM\tY\tfolder1\thpoTerm1\tWES\n"
+)
+
+# Use the GermlineTSVReader to read the test TSV file
+reader = GermlineTSVReader(tsv_data)
+data = reader.read_sheet()
+
+# Check that the patient name with the hyphen is correctly included in the data
+assert "Smith-Jones" in [entity["patientName"] for entity in data["bioEntities"].values()]
+print("Test completed successfully, no errors.")
