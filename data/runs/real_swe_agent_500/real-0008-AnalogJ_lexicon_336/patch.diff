+import subprocess
+
+# The command that fails, split into a list for Popen
+cmd = ["lexicon", "memset", "create", "example.com", "TXT", "--name", "_acme-challenge.example.com", "--content", "BLAH", "--ttl", "300"]
+
+# Use subprocess to run the command and capture the output
+try:
