+def switch_tenant(tenant_id, username, client_name, cache_dir):
+    """ Switch Agave Tenant
+
+    Switch the current context to a specified Agave tenant, username, and client name.
+    The current context along with all previous used are stored in a
+    local database (arguments.agavedb).
+
+    The ~/.agave/config.json file will have the following format:
+        * "current" will specify the configuration to be used for the current 
+          session. The contents of this section should match those of 
+          ~/.agave/current.
+        * "sessions" will have one or more keys, and each key will have a json 
+          object related to it. Each key will correspond to a tenant id.
+
+    For example:
+    {
+        "current": {
+            "access_token": "some-token",
+            ...
+            "username": "user"
+        },
+        "sessions": {
+            "3dem": {
+                "admin": {
+                    "client-1": {
+                        ...
+                    },
+                    "client-2": {
+                        ...
+                    }
+                },
+                "user1":{
+                    "client-1": {
+                        ...
+                    },
+                    "client-2": {
+                        ...
+                    }
+                }
+            },
+            "sd2e": {
+                "admin": {
+                    "client-1": {
+                        ...
+                    }
+                }
+            }
+        }
+    }
+
+    PARAMETERS
+    ----------
+    tenant_id: str
+        The id of the tenant to switch to.
+    username: str
+        The username to switch to.
+    client_name: str
+        The client name to switch to.
+    cache_dir: str
+        The location to store the configuration.
+    """
+    # Get location to store configuration.
+    make_cache_dir(cache_dir)
+    current_file = "{}/current".format(cache_dir)
+    config_file = "{}/config.json".format(cache_dir)
+    config_files = [current_file, config_file]
+
+    # Load the config.json file
+    with open(config_file, "r") as f:
+        agave_context = json.load(f)
+
+    # Set the current context
+    agave_context["current"] = agave_context["sessions"][tenant_id][username][client_name]
+
+    # Save the changes to the config.json file
+    with open(config_file, "w") as f:
+        json.dump(agave_context, f, sort_keys=True, indent=4)
