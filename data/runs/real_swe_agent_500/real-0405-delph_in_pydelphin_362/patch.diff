diff --git a/test_comment_formatting.py b/test_comment_formatting.py
new file mode 100644
index 0000000..816b26b
--- /dev/null
+++ b/test_comment_formatting.py
@@ -0,0 +1,13 @@
+import delphin.tdl as tdl
+
+# Create a simple TDL object with a comment
+tdl_obj = "// This is a line comment\n[ SYNSEM.LOCAL.CAT.HEAD.MOD < > ]"
+
+# Parse the TDL string
+tdl_obj = tdl.parse(tdl_obj)
+
+# Format the TDL object
+formatted_tdl = tdl.format(tdl_obj)
+
+# Print the formatted TDL
+print(formatted_tdl)
