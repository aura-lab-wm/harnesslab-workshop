@@ -0,0 +1,20 @@
+from igseq.vdj_gather import vdj_gather
+from igseq.vdj import parse_vdj_paths
+
+# Test paths, including duplicates
+test_paths = [
+    "sonarramesh/IGH",
+    "sonarramesh/IGH/IGHD",
+    "sonarramesh/IGK",
+    "sonarramesh/IGH/IGHD"  # Duplicate
+]
+
+# Call vdj_gather with the test paths
+result = vdj_gather(test_paths, "/tmp/test_output")
+
+# Print the results
+print("Result:", result)
+
+# Check for duplicates in the processed paths
+processed_paths = [attrs["input"] for attrs in parse_vdj_paths(test_paths)]
+print("Processed paths:", processed_paths)
