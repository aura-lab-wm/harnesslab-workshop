
diff --git a/comments.py b/comments.py
new file mode 100644
index 0000000..5ec18b3
--- /dev/null
+++ b/comments.py
@@ -0,0 +1,14 @@
+class LineComment:
+    def __init__(self, text):
+        self.text = text
+
+    def format(self):
+        return f'// {self.text}\n'
+
+class BlockComment:
+    def __init__(self, text):
+        self.text = text
+
+    def format(self):
+        lines = [f'// {line}' for line in self.text.split('\n')]
+        return '\n'.join(lines) + '\n'
