--- /dev/null
+++ b/test_hyphen.py
@@ -0,0 +1,19 @@
+from biomedsheets.io_tsv.germline import GermlineTSVReader, GermlineTSVSheetException
+from io import StringIO
+
+# Sample data that would previously raise the exception
+sample_data = """patientName\tfatherName\tmotherName\tsex\tisAffected\tfolderName\thpoTerms\tlibraryType
+John-Doe\tMichael-John\tMonica-Jane\tmale\taffected\tSmithFamily\tHP:123456\tGENOME"""
+# Use StringIO to simulate a file
+file_like = StringIO(sample_data)
+
+# Initialize GermlineTSVReader
+reader = GermlineTSVReader(file_like)
+
+# Attempt to read the sheet
+try:
+    sheet = reader.read_sheet()
+    print("Test passed: No exception raised for hyphen in patientName")
+except GermlineTSVSheetException as e:
+    print("Test failed: Exception raised for hyphen in patientName")
+    print(f"Error: {e}")
