diff --git a/reproduce.py b/reproduce.py
new file mode 100644
index 0000000..0da1e36
--- /dev/null
+++ b/reproduce.py
@@ -0,0 +1,25 @@
+import subprocess
+import sys
+
+# Define the command to simulate 'cfn submit'
+cmd = ["cfn", "submit", "--dry-run"]
+
+# Define the pip dependencies to install
+dependencies = ["requests", "boto3"]
+
+# Attempt to install the dependencies using pip
+for dep in dependencies:
+    try:
+        subprocess.run([sys.executable, "-m", "pip", "install", dep], check=True)
+    except subprocess.CalledProcessError as e:
+        print(f"Error installing {dep}: {e}")
+
+# Run the 'cfn submit' command
+try:
+    result = subprocess.run(cmd, capture_output=True, text=True)
+    print(result.stdout)
+    print(result.stderr)
+except Exception as e:
+    print(f"Error running 'cfn submit': {e}")
+
+print("Script completed successfully, no errors.")
