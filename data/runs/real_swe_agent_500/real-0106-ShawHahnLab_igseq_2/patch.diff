diff --git a/test_parse_vdj_paths.py b/test_parse_vdj_paths.py
new file mode 100644
index 0000000..7ffff4f
--- /dev/null
+++ b/test_parse_vdj_paths.py
@@ -0,0 +1,23 @@
+from igseq.vdj import parse_vdj_paths, get_internal_vdj
+from pathlib import Path
+
+# Get a list of valid FASTA paths
+valid_paths = get_internal_vdj("rhesus")
+
+# Create a list of paths with duplicates
+ref_paths = [valid_paths[0], valid_paths[1], valid_paths[0]]
+
+# Call the parse_vdj_paths function
+attrs_list = parse_vdj_paths(ref_paths)
+print(attrs_list)
+
+# Check that the list contains the correct number of elements
+assert len(attrs_list) == 2, "List should contain 2 elements"
+
+# Check that the first element is for the V segment
+assert attrs_list[0]["segment"] == "V", "First element should be for the V segment"
+
+# Check that the second element is for the D segment
+assert attrs_list[1]["segment"] == "D", "Second element should be for the D segment"
+
+print("All tests passed successfully")
