+++ b/compare_init.py
@@ -0,0 +1,25 @@
+from sqlalchemy import Column, Integer, Table
+from sqlalchemy.orm import Session
+from sqlalchemy_mixin import AllFeaturesMixin
+
+class OldAllFeaturesMixin(AllFeaturesMixin):
+    __abstract__ = True
+
+    # SOME OTHER CODE
+    pass
+
+class NewAllFeaturesMixin(AllFeaturesMixin):
+    __abstract__ = True
+
+    # SOME CODE
+    pass
+
+class MyClass(OldAllFeaturesMixin):
+    pass
+
+# Attempt to map MyClass to a table
+table_name = "my_class"
+columns = [Column("id", Integer, primary_key=True)]
+Session.mapper(MyClass, Table(table_name, (Column(*c) for c in columns)))  # parenthesize the generator
+
+print("Script completed successfully, no errors.")
